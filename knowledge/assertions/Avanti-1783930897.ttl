@prefix cmk: <https://knowledge.semanticscore.net/knowledge/> .
@prefix cmo: <https://knowledge.semanticscore.net/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cmk:art-factory-porvoo a cmo:ConcertHall,
        cmo:Venue ;
    rdfs:label "Avanti Hall, Art Factory, Porvoo" .

cmk:avanti-chamber-orchestra a foaf:Group ;
    rdfs:label "Avanti! Chamber Orchestra" ;
    cmo:known-as-a cmk:ensemble ;
    cmo:performs-in cmk:art-factory-porvoo-20260625T1900 .

cmk:emilia-hoving a foaf:Person ;
    foaf:familyName "Hoving" ;
    foaf:firstName "Emilia" ;
    cmo:conducts-in cmk:art-factory-porvoo-20260625T1900 ;
    cmo:known-as-a cmk:conductor .

cmk:joonas-ahonen a foaf:Person ;
    foaf:familyName "Ahonen" ;
    foaf:firstName "Joonas" ;
    cmo:known-as-a cmk:pianist ;
    cmo:plays-in cmk:art-factory-porvoo-20260625T1900 .

cmk:manic-lines a cmo:Programme ;
    rdfs:label "Summer Sounds 2026: Opening Concert \"Manic Lines\"" ;
    cmo:is-performed-at cmk:art-factory-porvoo-20260625T1900 ;
    schema:hasPart cmk:composition-gretchen-am-spinnrade-eric-wubbels,
        cmk:composition-kamarisinfonia-nr-1-arnold-schoenberg,
        cmk:composition-sacrifice-suite-sarah-nemtsov,
        cmk:composition-scene-polidimensionali-xv-mániákus-vonalak-manic-lines-márton-illés .

cmk:composition-gretchen-am-spinnrade-eric-wubbels a schema:MusicComposition ;
    schema:composer cmk:eric-wubbels ;
    schema:dateCreated "2016"^^xsd:gYear ;
    schema:name "gretchen am spinnrade" .

cmk:composition-kamarisinfonia-nr-1-arnold-schoenberg a schema:MusicComposition ;
    schema:composer cmk:arnold-schoenberg ;
    schema:dateCreated "1906"^^xsd:gYear ;
    schema:name "Kamarisinfonia Nr. 1" .

cmk:composition-sacrifice-suite-sarah-nemtsov a schema:MusicComposition ;
    schema:composer cmk:sarah-nemtsov ;
    schema:dateCreated "2016"^^xsd:gYear,
        "2022"^^xsd:gYear ;
    schema:name "Sacrifice Suite" .

cmk:composition-scene-polidimensionali-xv-mániákus-vonalak-manic-lines-márton-illés a schema:MusicComposition ;
    schema:composer cmk:márton-illés ;
    schema:dateCreated "2008"^^xsd:gYear ;
    schema:name "Scene polidimensionali XV „Mániákus vonalak” (Manic Lines)" .

cmk:conductor a cmo:musical-identity .

cmk:ensemble a cmo:ensemble-identity .

cmk:pianist a cmo:musical-identity .

cmk:art-factory-porvoo-20260625T1900 a mo:Performance ;
    schema:name "Summer Sounds 2026: Opening Concert \"Manic Lines\"" ;
    schema:organizer cmk:avantimusic ;
    schema:startDate "2026-06-25T19:00:00"^^xsd:dateTime ;
    schema:url "https://avantimusic.fi/en/portfolio/summer-sounds-2026-opening-concert-manic-lines-2/"^^xsd:anyURI .

