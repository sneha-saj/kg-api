@prefix cmk: <https://knowledge.semanticscore.net/knowledge/> .
@prefix cmo: <https://knowledge.semanticscore.net/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cmk:final-concert-romeo-and-juliet a cmo:Programme ;
    rdfs:label "Final Concert - Romeo and Juliet" .

cmk:conductor a cmo:musical-identity .

cmk:kasmir-uusitupa a foaf:Person ;
    foaf:familyName "Uusitupa" ;
    foaf:firstName "Kasmir" ;
    cmo:conducts-in cmk:vaasa-city-hall-20260729T1900 ;
    cmo:known-as-a cmk:conductor .

cmk:mackenzie-melemed a foaf:Person ;
    foaf:familyName "Melemed" ;
    foaf:firstName "Mackenzie" ;
    cmo:known-as-a cmk:pianist ;
    cmo:plays-in cmk:vaasa-city-hall-20260729T1900 .

cmk:nicholas-daniel a foaf:Person ;
    foaf:familyName "Daniel" ;
    foaf:firstName "Nicholas" ;
    cmo:known-as-a cmk:oboist ;
    cmo:plays-in cmk:vaasa-city-hall-20260729T1900 .

cmk:oboist a cmo:musical-identity .

cmk:pianist a cmo:musical-identity .

cmk:vaasa-city-hall a cmo:ConcertHall,
        cmo:Venue ;
    rdfs:label "Vaasa City Hall" .

cmk:vaasa-city-hall-20260729T1900 a mo:Performance ;
    cmo:performs-in cmk:kasmir-uusitupa,
        cmk:mackenzie-melemed,
        cmk:nicholas-daniel ;
    schema:location cmk:vaasa-city-hall ;
    schema:name "Final Concert - Romeo and Juliet" ;
    schema:organizer cmk:kamariorkesteri ;
    schema:startDate "2026-07-29T19:00:00"^^xsd:dateTime ;
    schema:url "https://kamariorkesteri.fi/concerts/"^^xsd:anyURI .

